#!/bin/sh
# Agent and script shells (zsh -c, zsh -lc): treat `=word` and unmatched globs
# literally, as bash does, instead of failing the command.
[[ -o interactive ]] || setopt no_equals no_nomatch
# HISTFILE="$XDG_DATA_HOME"/zsh/history
HISTSIZE=1000000
SAVEHIST=1000000
export PATH="$HOME/.local/bin":$PATH
# Hermes-managed Node/npm global binaries, including Socket Firewall (sfw).
export PATH="$HOME/.hermes/node/bin:$PATH"
# pnpm global binary directory, used by pnpm global installs.
export PATH="$HOME/Library/pnpm/bin:$PATH"
### Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"
### bat as manpager
# export MANPAGER="bat -p"
# export BAT_THEME="TwoDark"
### spicetify
export PATH=$HOME/.spicetify:$PATH
### Bun.sh
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
### nvim as manpager
export MANPAGER='nvim +Man!'
export MANWIDTH=999
# cargo
export PATH=$HOME/.cargo/bin:$PATH
# golang
export PATH=$HOME/.local/share/go/bin:$PATH
export GOPATH=$HOME/.local/share/go
export GOBIN=$HOME/.local/share/go/bin
# fnm
export PATH="/Users/noah/Library/Application Support/fnm:$PATH"
eval "`fnm env`"
# node
export PATH=$HOME/.fnm:$PATH
export PATH="$PATH:./node_modules/.bin"
# deno
export DENO_INSTALL="/home/noah/.deno"
export PATH="$DENO_INSTALL/bin:$PATH"
# eval "$(zoxide init zsh)"
# eval "`pip completion --zsh`"
export PATH=$HOME/.config/nvcode/utils/bin:$PATH
export PATH=$HOME/.config/nvcode/utils/bin:$PATH
export PATH="$PATH:/usr/local/bin/Postman"
# java SDK
export JAVA_HOME="/Library/Java/JavaVirtualMachines/zulu-11.jdk/Contents/Home"
export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"
# andoird SDK
export ANDROID_HOME=$HOME/Library/Android/sdk
export PATH=$PATH:$ANDROID_HOME/emulator
export PATH=$PATH:$ANDROID_HOME/platform-tools
# phpenv
export PHPENV_ROOT="/usr/local/bin/phpenv"
if [ -d "${PHPENV_ROOT}" ]; then
    export PATH="${PHPENV_ROOT}/bin:${PATH}"
    eval "$(phpenv init -)"
fi
# rustup shell setup
# affix colons on either side of $PATH to simplify matching
case ":${PATH}:" in
    *:"$HOME/.cargo/bin":*)
        ;;
    *)
        # Prepending path in case a system-installed rustc needs to be overridden
        export PATH="$HOME/.cargo/bin:$PATH"
        ;;
esac

### Nvim as editor
export EDITOR='nvim'
export VISUAL='nvim'

# magic-enter
MAGIC_ENTER_GIT_COMMAND='git status --short && bgst'
MAGIC_ENTER_OTHER_COMMAND='eza --icons -a'

export USE_GKE_GCLOUD_AUTH_PLUGIN=True
# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/noah/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/noah/google-cloud-sdk/path.zsh.inc'; fi

export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# conda base Python for agent and script shells; interactive shells get the
# full conda setup from .zshrc
[[ -o interactive ]] || export PATH="/opt/homebrew/Caskroom/miniconda/base/bin:$PATH"

# mcfly setup — own ctrl-r completely
export MCFLY_KEY_SCHEME=vim
[[ -o interactive ]] && eval "$(mcfly init zsh)"

# zsh-vi-mode rebuilds keymaps at the first prompt (and fzf also grabs ^R),
# clobbering mcfly's binding. Re-assert it in vi-mode's after-init hook,
# which runs last, so McFly wins in every keymap.
function zvm_after_init() {
  bindkey -M emacs '^R' mcfly-history-widget
  bindkey -M viins '^R' mcfly-history-widget
  bindkey -M vicmd '^R' mcfly-history-widget
}
